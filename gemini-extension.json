{
  "name": "markifact",
  "version": "1.0.0",
  "description": "Performance marketing automation across Google Ads, Meta Ads, GA4, Shopify and more via Markifact's remote MCP server.",
  "mcpServers": {
    "markifact": {
      "url": "https://api.markifact.com/mcp",
      "type": "http",
      "timeout": 120000,
      "oauth": {
        "authorizationUrl": "https://www.markifact.com/oauth/authorize",
        "tokenUrl": "https://api.markifact.com/oauth/token",
        "registrationUrl": "https://www.markifact.com/oauth/register",
        "scopes": ["mcp"]
      }
    }
  },
  "contextFileName": "GEMINI.md",
  "commandsDirectory": "gemini/commands"
}
